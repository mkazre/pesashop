{
  "expo": {
    "name": "Pesa Shop",
    "slug": "pesa-shop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pesashop",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pesashop.mobile",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:pesashop.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Pesa Shop uses your camera to let you upload product review photos.",
        "NSPhotoLibraryUsageDescription": "Pesa Shop accesses your photo library so you can upload profile and review images.",
        "NSPhotoLibraryAddUsageDescription": "Pesa Shop saves images to your photo library.",
        "NSMicrophoneUsageDescription": "Pesa Shop uses your microphone for voice-enabled chat support.",
        "NSFaceIDUsageDescription": "Pesa Shop uses Face ID to securely log you in.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pesashop.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "pesashop.com", "pathPrefix": "/product" },
            { "scheme": "https", "host": "pesashop.com", "pathPrefix": "/order" },
            { "scheme": "https", "host": "pesashop.com", "pathPrefix": "/refer" },
            { "scheme": "https", "host": "pesashop.com", "pathPrefix": "/live" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F604B",
          "defaultChannel": "default",
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-asset",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a547ffd4-858c-45bb-b527-495e2264a8da"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/a547ffd4-858c-45bb-b527-495e2264a8da"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "mkazre"
  }
}
