# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database
# Local: mongodb://localhost:27017/ecommerce_platform
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pesashop?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ecommerce_platform

# JWT Secret (CHANGE THIS in production — use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URLs
# Local dev:
ADMIN_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# Production:
# ADMIN_URL=https://admin.pesashop.com
# FRONTEND_URL=https://pesashop.com

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@yourstore.com

# Currency API
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest/ZAR
CURRENCY_UPDATE_INTERVAL=6

# Google Cloud Translation API — console.cloud.google.com, enable "Cloud
# Translation API", create an API key. Free tier: 500,000 chars/month.
# Used by services/translationService.js (product/category on-demand
# translation) and scripts/generate-translations.js (static UI string batch
# translation). Leave unset to disable translation (storefront falls back to
# English for non-English locales rather than erroring).
GOOGLE_TRANSLATE_API_KEY=

# Payment Gateways
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Base Currency
BASE_CURRENCY=ZAR

# Chat Service
CHAT_SERVICE_ENABLED=true

# Image Processing
IMAGE_QUALITY=90
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
WATERMARK_OPACITY=0.7

# Social Auto-Poster module
# Set to 'true' to make the publisher worker use the Phase 4 stub adapter
# (logs instead of calling real platform APIs) instead of the real Phase 5
# adapters. Useful for local testing without real, approved developer-app
# credentials. Leave unset/false in any environment meant to publish for real.
AUTOPOSTER_DRY_RUN=false

# Token encryption key — generate with: openssl rand -hex 32
SOCIAL_TOKEN_KEY=

# Meta (Facebook + Instagram) — developers.facebook.com, one app covers both.
# Register ONLY this one redirect URI in the Meta dashboard for both platforms —
# the callback handler tells facebook and instagram apart via the stored OAuth
# state, not the URL, so one shared URI is correct here (not a typo).
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:5000/api/autoposter/oauth/facebook/callback

# X (Twitter) — developer.x.com, requires Basic tier (~$200/mo) for write access
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://localhost:5000/api/autoposter/oauth/x/callback

# LinkedIn — linkedin.com/developers, requires Marketing Developer Platform approval
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:5000/api/autoposter/oauth/linkedin/callback

# TikTok — developers.tiktok.com. Note: CLIENT_KEY, not CLIENT_ID. Direct Post
# publishing requires a separate approval on top of this base API access.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:5000/api/autoposter/oauth/tiktok/callback
